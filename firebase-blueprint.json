{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "A user-placed e-commerce order containing cart item snapshot, totals, and simulated delivery info",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "subtotal": { "type": "number" },
        "shippingCost": { "type": "number" },
        "deliveryInfo": { "type": "object" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "items", "total", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}/orders/{orderId}": {
      "schema": "Order",
      "description": "User-specific orders scoped strictly to their authenticated owner"
    }
  }
}
